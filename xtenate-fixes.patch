 // Simuleer een eenvoudige state
 const mockState = {
   TX: [
@@ -76,8 +78,11 @@ console.log('    → Korrektheid: ' + (afterHistDelete === beforeHistDelete - 1
 console.log('TEST 3: Controleer integriteit na verwijdering');
 console.log('  TX bevat nog:', mockState.TX.length, 'boekingen');
 console.log('  HIST_TX bevat nog:', mockState.HIST_TX.length, 'boekingen');
-console.log('  ✓ Totaal: ' + (mockState.TX.length + mockState.HIST_TX.length) + ' boekingen (verwacht: ' + (3 + 2 - 2) + ')');
-const isCorrect = (mockState.TX.length + mockState.HIST_TX.length) === 3;
